{
  "expo": {
    "name": "BarcodesScanner Pro",
    "slug": "omniscan-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f3d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barcodesscanner.pro",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "BarcodesScanner Pro uses Bluetooth to connect to and provision ESP32 barcode scanners.",
        "NSBluetoothPeripheralUsageDescription": "BarcodesScanner Pro uses Bluetooth to connect to and provision ESP32 barcode scanners.",
        "NSCameraUsageDescription": "BarcodesScanner Pro uses the camera to scan barcodes and capture product photos.",
        "NSPhotoLibraryUsageDescription": "BarcodesScanner Pro lets you choose photos for profile and product images.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1f3d"
      },
      "package": "com.barcodesscanner.pro",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "barcodesscanner.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
"plugins": [
  [
    "expo-camera",
    {
      "cameraPermission": "BarcodesScanner Pro uses the camera to scan barcodes and capture product photos."
    }
  ],
  [
    "expo-image-picker",
    {
      "photosPermission": "BarcodesScanner Pro lets you choose photos for profile and product images."
    }
  ],
  "expo-dev-client",
  "./withAdMob"
],
    "extra": {
      "eas": {
        "projectId": "7952cf59-3513-40ab-88f4-8470aab2fa2e"
      }
    },
    "owner": "yuensinghor"
  }
}